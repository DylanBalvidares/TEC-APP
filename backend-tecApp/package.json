{
  "name": "backend-tecApp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:docker": "docker compose -f ../docker-compose.yml exec -T backend npm run db:migrate",
    "seed": "docker compose -f ../docker-compose.yml exec -T backend node /app/src/db/seed.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.0",
    "mysql2": "^3.9.0",
    "nodemailer": "^6.9.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
