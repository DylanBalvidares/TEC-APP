[TEMPLATE]
# CAMBIAR PASSWORDS AL USAR DOCKER-COMPOSE

# --- Base de datos ---
# docker-compose exige MYSQL_ROOT_PASSWORD (no usa root_pass por defecto).
MYSQL_ROOT_PASSWORD="cambiar-esta-password"
MYSQL_DATABASE="gestion_tecnica2"
DATABASE_URL="mysql://root:cambiar-esta-password@mysql-db:3306/gestion_tecnica2"
DATABASE_USER="root"
DATABASE_PASSWORD="cambiar-esta-password"
DATABASE_NAME="gestion_tecnica2"
DATABASE_HOST="mysql-db"
DATABASE_PORT=3306

# --- Entorno ---
# En producción: NODE_ENV=production + JWT_SECRET obligatorio (el arranque falla si falta).
NODE_ENV=production

# --- JWT ---
# Obligatorio fuera de development/test. Generá uno con: openssl rand -hex 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=8h

# --- CORS ---
# Lista separada por comas de orígenes permitidos. En producción es obligatoria
# (si queda vacía, se rechazan los orígenes cruzados).
CORS_ORIGINS="http://localhost:5173"

# --- Uploads ---
# Carpeta donde se guardan las imágenes de noticias (dentro del contenedor).
UPLOADS_DIR="/app/uploads"

# Tamaño máximo del body JSON (por defecto 1mb).
JSON_BODY_LIMIT="1mb"
